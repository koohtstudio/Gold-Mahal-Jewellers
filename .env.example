# Gold Mahal Jewellers: environment variables.
# Copy to .env.local for local work. Never commit real values.

# mock : data lives in this browser (localStorage). Default. No backend needed.
# demo : same screens, data shared across devices through one Neon table (sample data only).
# live : the real relational backend (lib/repo/neon). Not built yet, fails loudly at startup.
NEXT_PUBLIC_APP_MODE=mock

# Public site search indexing. Leave false while the data is sample.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Canonical site URL (used for Open Graph and the sitemap). Optional.
NEXT_PUBLIC_SITE_URL=

# Simulated latency in the mock store: "off" or "min-max" milliseconds.
NEXT_PUBLIC_MOCK_LATENCY=150-400

# demo mode: which shared room to use. Add ?room=name to a URL to try a private one.
NEXT_PUBLIC_DEMO_ROOM=pitch

# demo and live: Neon pooled connection string (server only).
DATABASE_URL=

# live only (placeholders, see TODO-LIVE.md)
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
RESEND_API_KEY=
CRON_SECRET=
SMS_PROVIDER_KEY=
STRIPE_SECRET_KEY=
RATE_FEED_API_KEY=
